# Public site URL (used for canonical URLs, sitemap, Open Graph, schema)
NEXT_PUBLIC_SITE_URL=https://www.signova.co.uk

# ── Analytics (loaded only after cookie consent) ──
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Lead delivery: enable any combination ──
# Email via Resend (includes uploaded logo/photos as attachments)
RESEND_API_KEY=
LEAD_EMAIL_TO=studio@signova.co.uk
LEAD_EMAIL_FROM="SIGNOVA Website <leads@signova.co.uk>"

# Generic JSON webhook: Zapier / Make / n8n → Pipedrive, Salesforce, Monday, etc.
LEAD_WEBHOOK_URL=

# Google Sheets: deploy docs/google-sheets-apps-script.js as a web app and paste its URL
GOOGLE_SHEETS_WEBHOOK_URL=

# HubSpot Forms API (no private key needed)
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# WhatsApp Cloud API: notifies the studio's phone of each new lead
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=
